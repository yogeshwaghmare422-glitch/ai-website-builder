PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_builder?schema=public"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Stripe is optional while developing the generator.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=inr

# First admin user created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
